#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="${ROOT_DIR}/bin/mdb"

if [ -x "$BIN" ] && [ -z "$(find "${ROOT_DIR}/cmd" "${ROOT_DIR}/pkg" -name '*.go' -newer "$BIN" 2>/dev/null | head -n 1)" ] && [ ! "${ROOT_DIR}/go.mod" -nt "$BIN" ]; then
  cd "$ROOT_DIR"
  exec "$BIN" "$@"
fi

if ! command -v go >/dev/null 2>&1; then
  echo "Error: Go toolchain not found and $BIN is missing or stale." >&2
  exit 1
fi

cd "$ROOT_DIR"
exec go run ./cmd/mdb "$@"
